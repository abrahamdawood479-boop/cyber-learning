 ### OVERLOADED FUNCTIONS ###
 
 //Same Name, Different Blueprints: Overloading lets you reuse the exact same function name multiple times as long as each version takes different types or amounts of data.

 //Automatic Routing: The compiler automatically checks the values inside your parentheses and instantly matches them to the correct function version.

 //No Name Confusion: You do not need to invent clumsy names like printInt() or printString(); C++ handles the separation behind the scenes based purely on position and data types.
 
 
 
 ## CODE 1 ##
 
 #include <iostream>
 #include <string>

 // --- 1. THE FIRST FUNCTION ---
 // Takes just one integer
 void printData(int score) {
     std::cout << "Score: " << score << "\n";
 }

 // --- 2. THE SECOND OVERLOADED FUNCTION ---
 // Same name, but takes a string instead
 void printData(std::string name) {
     std::cout << "Name: " << name << "\n";
 }

 // --- 3. THE THIRD OVERLOADED FUNCTION ---
 // Same name, but takes both a string AND an integer
 void printData(std::string name, int score) {
     std::cout << "Player " << name << " scored " << score << " points!\n";
 }

 int main() {
     // Uses the 1st function (matches the integer slot)
     printData(150);
     
     // Uses the 2nd function (matches the string slot)
     printData("Mario");
     
     // Uses the 3rd function (matches both slots in order)
     printData("Luigi", 250);
     
     return 0;
 }
 
 
 
 
