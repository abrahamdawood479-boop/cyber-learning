 #include <iostream>

 // The Deal: This package is named "doubleNum".
 // It takes an int, and PROMISES to return an int back to you.
 int doubleNum(int mynum);

 int main() {
     int original = 5;
     
     // We call the package, it does the math, and returns a 10.
     // We catch that 10 and save it into a new variable called 'result'.
     int result = doubleNum(original);
     
     std::cout << result; // Prints 10
 }

 // Fulfilling the Deal
 int doubleNum(int mynum) {
     int calculatedAnswer = mynum * 2;
     
     return calculatedAnswer; // This shoots the value back to main()!
 }


